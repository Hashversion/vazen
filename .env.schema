#
#
# Shared root config — packages import from here, never the reverse.
#
# @defaultRequired=infer @defaultSensitive=false
# @plugin(@varlock/infisical-plugin)
# ----------

# Set per context (CI: staging / production).
# @public @required=false @type=enum(development, staging, test, production)
# @icon=mdi:server
APP_ENV=development

# Infisical env slug for APP_ENV (dev / staging / prod).
# @public @required=false
# @icon=mdi:cloud
INFISICAL_ENV=remap($APP_ENV, "development", dev, "staging", staging, "production", prod, dev)
