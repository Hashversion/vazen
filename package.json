{
  "name": "vazen",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "clean": "turbo clean && rimraf .fallow .turbo node_modules",
    "prepare": "lefthook install",
    "fmt:check": "oxfmt --check",
    "fmt": "oxfmt",
    "lint": "mise run lint",
    "check": "mise run lint && oxfmt --check",
    "typecheck": "turbo typecheck",
    "secrets:scan": "varlock scan apps/*/src packages/*/src tooling e2e",
    "fallow": "fallow",
    "fallow:dead": "fallow dead-code --format human",
    "fallow:dupes": "fallow dupes --format human",
    "fallow:health": "fallow health --format human",
    "env:codegen": "turbo run env:codegen",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:clean": "docker compose down -v",
    "dev": "turbo dev",
    "build": "turbo build",
    "e2e": "turbo e2e",
    "web:dev": "turbo dev -F web...",
    "web:build": "turbo build -F web...",
    "web:e2e:local": "pnpm --filter web e2e:local",
    "web:e2e": "turbo e2e -F @e2e/web",
    "docs:dev": "turbo dev -F docs...",
    "docs:build": "turbo build -F docs..."
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@effect/tsgo": "0.73.2",
    "@shadcn/lint": "0.2.5",
    "@types/node": "catalog:",
    "@varlock/infisical-plugin": "catalog:",
    "fallow": "3.43.2",
    "lefthook": "2.2.2",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-plugin-react-doctor": "0.9.23",
    "portless": "0.17.0",
    "renovate": "44.246.4",
    "rimraf": "6.1.4",
    "tsrs": "7.1.0-beta.tsrs3",
    "turbo": "2.11.13",
    "typescript": "catalog:",
    "ultracite": "8.3.1",
    "varlock": "catalog:"
  },
  "engines": {
    "node": "24.22.1"
  },
  "packageManager": "pnpm@12.21.0",
  "varlock": {
    "loadPath": [
      "apps/web/",
      "apps/docs/"
    ]
  }
}
