{
  "name": "vazen",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "clean": "turbo clean && rimraf .fallow .turbo node_modules",
    "dev": "turbo dev",
    "docker:clean": "docker compose down -v",
    "docker:down": "docker compose down",
    "docker:up": "docker compose up -d",
    "docs:build": "turbo build -F docs...",
    "docs:dev": "turbo dev -F docs...",
    "e2e": "turbo e2e",
    "env:codegen": "turbo run env:codegen",
    "fallow": "fallow",
    "fallow:dead": "fallow dead-code --format human",
    "fallow:dupes": "fallow dupes --format human",
    "fallow:health": "fallow health --format human",
    "fmt": "oxfmt",
    "secrets:scan": "varlock scan apps/*/src packages/*/src tooling e2e",
    "typecheck": "turbo typecheck",
    "web:build": "turbo build -F web...",
    "web:dev": "turbo dev -F web...",
    "web:e2e": "turbo e2e -F @e2e/web",
    "web:e2e:local": "pnpm --filter web e2e:local",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@types/node": "catalog:",
    "@varlock/infisical-plugin": "catalog:",
    "fallow": "3.43.0",
    "lefthook": "2.2.2",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-plugin-react-doctor": "^0.9.23",
    "portless": "0.17.0",
    "renovate": "44.239.1",
    "rimraf": "6.1.4",
    "turbo": "2.11.11",
    "typescript": "catalog:",
    "ultracite": "8.2.1",
    "varlock": "catalog:"
  },
  "engines": {
    "node": "24.22.1"
  },
  "packageManager": "pnpm@12.11.2",
  "varlock": {
    "loadPath": [
      "apps/web/",
      "apps/docs/"
    ]
  }
}
