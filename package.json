{
  "name": "vazen",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "clean": "turbo clean && rimraf .fallow .turbo node_modules",
    "dev": "turbo dev",
    "docker:clean": "docker compose down -v",
    "docker:down": "docker compose down",
    "docker:up": "docker compose up -d",
    "docs:build": "turbo build -F docs...",
    "docs:dev": "turbo dev -F docs...",
    "e2e": "turbo e2e",
    "fallow": "fallow",
    "fallow:dead": "fallow dead-code --format human",
    "fallow:dupes": "fallow dupes --format human",
    "fallow:health": "fallow health --format human",
    "fmt": "oxfmt",
    "secrets:scan": "infisical scan",
    "typecheck": "turbo typecheck",
    "web:build": "turbo build -F web...",
    "web:dev": "turbo dev -F web...",
    "web:e2e": "turbo e2e -F @e2e/web",
    "web:e2e:local": "pnpm --filter web e2e:local",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@infisical/cli": "^0.43.121",
    "@types/node": "catalog:",
    "fallow": "^3.15.0",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-plugin-react-doctor": "^0.7.8",
    "portless": "^0.15.5",
    "rimraf": "^6.1.3",
    "turbo": "^2.10.9",
    "typescript": "catalog:",
    "ultracite": "7.10.3"
  },
  "engines": {
    "node": ">=22.23.2"
  },
  "packageManager": "pnpm@10.34.5"
}
