{
  "name": "@repo/flags",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#env": "./env.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./*": {
      "default": "./src/*.ts"
    },
    "./feature": "./src/feature/index.ts",
    "./env": "./env.ts"
  },
  "scripts": {
    "clean": "rimraf .turbo node_modules",
    "env:codegen": "varlock codegen",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@flags-sdk/statsig": "0.3.1",
    "@repo/auth": "workspace:*",
    "flags": "4.3.0",
    "nanoid": "5.1.16",
    "varlock": "catalog:"
  },
  "devDependencies": {
    "@repo/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "next": "catalog:next"
  }
}
