{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    "group:monorepos",
    "group:recommended"
  ],
  "dependencyDashboard": true,
  "prConcurrentLimit": 4,
  "prHourlyLimit": 2,
  "rangeStrategy": "bump",
  "baseBranchPatterns": ["dev"],
  "postUpdateOptions": ["pnpmDedupe"],
  "schedule": ["before 5am on Monday"],
  "updateNotScheduled": false,
  "rebaseWhen": "conflicted",
  "semanticCommitType": "chore",
  "labels": ["dependencies"],
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": ["at any time"],
    "labels": ["security", "dependencies"]
  },
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "platformAutomerge": true,
    "schedule": ["before 5am on Monday"]
  },
  "packageRules": [
    {
      "description": "auto :: patch (all) + dev minor in one branch, automerge via queue after 3-day cooldown",
      "groupName": "Auto-merge updates",
      "matchUpdateTypes": ["patch"],
      "minimumReleaseAge": "3 days",
      "automerge": true,
      "platformAutomerge": true,
      "labels": ["dependencies", "automerge"]
    },
    {
      "description": "auto :: dev minor joins the same branch as patch",
      "groupName": "Auto-merge updates",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor"],
      "minimumReleaseAge": "3 days",
      "automerge": true,
      "platformAutomerge": true,
      "labels": ["dependencies", "automerge"]
    },
    {
      "description": "prod minor :: PR only, 5-day cooldown :: behavioral changes may affect users",
      "groupName": "Production dependency minor updates",
      "matchDepTypes": ["dependencies"],
      "matchUpdateTypes": ["minor"],
      "minimumReleaseAge": "5 days",
      "automerge": false,
      "labels": ["dependencies", "minor"]
    },
    {
      "description": "major :: manual review required, deprioritized in dashboard",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "automerge": false,
      "groupName": "Major version updates",
      "labels": ["dependencies", "major", "breaking-change"]
    },
    {
      "description": "pnpm catalog :: exact pins have no range so replace is used instead of bump :: 7-day quarantine (runtime foundation)",
      "matchManagers": ["pnpm"],
      "matchDepTypes": ["pnpmCatalog"],
      "rangeStrategy": "replace",
      "minimumReleaseAge": "7 days",
      "automerge": false,
      "labels": ["dependencies", "catalog"]
    }
  ]
}
