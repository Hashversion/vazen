#!/bin/sh
# What :: Stable oxlint entrypoint for editors, hooks, and scripts.
# Why :: Stock oxlint cannot load the effecttsgo plugin used by @effect/tsgo/oxlint-presets; lint must run through the Effect tsrs-lint proxy.
# How :: Delegate to the mise lint task quietly so CLI, hooks, and editor LSP callers share one command without extra stdout.
exec mise run -q lint -- "$@"
