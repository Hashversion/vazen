#
#
# This app's Infisical project. Strict mode: required secrets
# missing from Infisical ERROR (no silent fallbacks when on).
# Optional keys fall back to "" — same as their normal empty state.
# Creds (project ID + machine identity): apps/web/.env.local locally,
# secrets step in CI. Never bundled.
#
# @defaultRequired=infer @defaultSensitive=false
# @initInfisical(projectId=$INFISICAL_PROJECT_ID, environment=$INFISICAL_ENV, secretPath=/vazen-web, clientId=$INFISICAL_CLIENT_ID, clientSecret=$INFISICAL_CLIENT_SECRET)
# @import(../../, pick=[APP_ENV, INFISICAL_ENV])
# ----------

# Infisical project ID (UUID). One per Infisical project — same value for
# every APP_ENV unless environments live in separate projects.
# @public @required=false
# @docs("Infisical machine identities", https://infisical.com/docs/documentation/platform/identities/machine-identities)
# @icon=mdi:folder
INFISICAL_PROJECT_ID=
# @type=infisicalClientId @required=false
# @docs("Infisical machine identities", https://infisical.com/docs/documentation/platform/identities/machine-identities)
# @icon=mdi:account
INFISICAL_CLIENT_ID=
# @type=infisicalClientSecret @sensitive @internal @required=false
# @docs("Infisical machine identities", https://infisical.com/docs/documentation/platform/identities/machine-identities)
# @icon=mdi:key
INFISICAL_CLIENT_SECRET=

# Upstash Redis
# @type=url @sensitive @required
# @docs("Upstash Redis docs", https://upstash.com/docs)
# @icon=logos:redis
UPSTASH_REDIS_REST_URL=infisical()
# @sensitive @required
# @docs("Upstash Redis docs", https://upstash.com/docs)
# @icon=logos:redis
UPSTASH_REDIS_REST_TOKEN=infisical()

# Database
# @type=url @sensitive @required
# @docs("PostgreSQL connection strings", https://www.postgresql.org/docs/current/libpq-connect.html#LIBPQ-CONNSTRING)
# @icon=logos:postgresql
DATABASE_URL=infisical()

# Google OAuth
# @sensitive @required
# @docs("Create access credentials", https://developers.google.com/workspace/guides/create-credentials)
# @icon=logos:google-icon
GOOGLE_CLIENT_ID=infisical()
# @sensitive @required
# @docs("Create access credentials", https://developers.google.com/workspace/guides/create-credentials)
# @icon=logos:google-icon
GOOGLE_CLIENT_SECRET=infisical()

# Cloudflare R2 (optional — empty is their normal state)
# @sensitive @required=false
# @docs("R2 API tokens", https://developers.cloudflare.com/r2/api/tokens/)
# @icon=logos:cloudflare
R2_ACCOUNT_ID=fallback(infisical(allowMissing=true), "")
# @sensitive @required=false
# @docs("R2 API tokens", https://developers.cloudflare.com/r2/api/tokens/)
# @icon=logos:cloudflare
R2_ACCESS_KEY_ID=fallback(infisical(allowMissing=true), "")
# @sensitive @required=false
# @docs("R2 API tokens", https://developers.cloudflare.com/r2/api/tokens/)
# @icon=logos:cloudflare
R2_SECRET_ACCESS_KEY=fallback(infisical(allowMissing=true), "")

# PostHog
# @type=string(startsWith=phc_) @required @public
# @docs("PostHog API keys", https://posthog.com/docs/api)
# @icon=simple-icons:posthog
NEXT_PUBLIC_POSTHOG_KEY=infisical()
# @type=url @required @public
# @docs("PostHog API keys", https://posthog.com/docs/api)
# @icon=simple-icons:posthog
NEXT_PUBLIC_POSTHOG_HOST=infisical()

# Sentry
# @required
# @docs("Sentry Next.js", https://docs.sentry.io/platforms/javascript/guides/nextjs/)
# @icon=simple-icons:sentry
SENTRY_ORG=infisical()
# @required
# @docs("Sentry Next.js", https://docs.sentry.io/platforms/javascript/guides/nextjs/)
# @icon=simple-icons:sentry
SENTRY_PROJECT=infisical()
# @type=url @required
# @docs("Sentry DSN", https://docs.sentry.io/concepts/key-terms/dsn-explainer/)
# @icon=simple-icons:sentry
NEXT_PUBLIC_SENTRY_DSN=infisical()
# @type=url @required
# @docs("Sentry Next.js", https://docs.sentry.io/platforms/javascript/guides/nextjs/)
# @icon=simple-icons:sentry
NEXT_PUBLIC_SENTRY_CSP_REPORT_ENDPOINT=infisical()

# Feature Flags (FLAGS_SECRET optional — only needed for precompute)
# @sensitive @required=false
# @docs("Flags precompute", https://flags-sdk.dev/docs/frameworks/next/precompute#prerequisites)
# @icon=mdi:flag
FLAGS_SECRET=fallback(infisical(allowMissing=true), "")
# @sensitive @required
# @docs("Statsig API keys", https://docs.statsig.com/access-management/api-keys)
# @icon=mdi:flag
STATSIG_SERVER_API_KEY=infisical()
