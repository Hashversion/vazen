#
#
# This app's Infisical project. Strict mode: required secrets
# missing from Infisical ERROR (no silent fallbacks when on).
# Optional keys fall back to "" — same as their normal empty state.
# Auth: GitHub Actions OIDC in CI (identityId + oidcToken); Universal Auth locally
# (apps/web/.env.local). Universal Auth wins when creds exist, so CI must omit them. Never bundled.
#
# @defaultRequired=infer @defaultSensitive=false
# @initInfisical(projectId=$INFISICAL_PROJECT_ID, environment=$INFISICAL_ENV, secretPath=/web, identityId=$INFISICAL_IDENTITY_ID, oidcToken=$INFISICAL_OIDC_TOKEN, clientId=$INFISICAL_CLIENT_ID, clientSecret=$INFISICAL_CLIENT_SECRET)
# @import(../../, pick=[APP_ENV, INFISICAL_ENV])
# ----------

# Infisical project ID (UUID). One per Infisical project — same value for
# every APP_ENV unless environments live in separate projects.
# @public @required=false
INFISICAL_PROJECT_ID=

# OIDC machine identity (CI only). Empty locally → Universal Auth below.
# @required=false
INFISICAL_IDENTITY_ID=
# GitHub Actions OIDC JWT, fetched in CI so varlock skips Vercel's auto-detected token.
# @sensitive @internal @required=false
INFISICAL_OIDC_TOKEN=
# @type=infisicalClientId @sensitive @internal @required=false
INFISICAL_CLIENT_ID=
# @type=infisicalClientSecret @sensitive @internal @required=false
INFISICAL_CLIENT_SECRET=

# Upstash Redis
# @type=url @sensitive @required
UPSTASH_REDIS_REST_URL=infisical()
# @sensitive @required
UPSTASH_REDIS_REST_TOKEN=infisical()

# Database
# @type=url @sensitive @required
DATABASE_URL=infisical()

# Google OAuth
# @sensitive @required
GOOGLE_CLIENT_ID=infisical()
# @sensitive @required
GOOGLE_CLIENT_SECRET=infisical()

# Cloudflare R2 (optional — empty is their normal state)
# @sensitive @required=false
R2_ACCOUNT_ID=fallback(infisical(allowMissing=true), "")
# @sensitive @required=false
R2_ACCESS_KEY_ID=fallback(infisical(allowMissing=true), "")
# @sensitive @required=false
R2_SECRET_ACCESS_KEY=fallback(infisical(allowMissing=true), "")

# PostHog
# @type=string(startsWith=phc_) @required @public
NEXT_PUBLIC_POSTHOG_KEY=infisical()
# @type=url @required @public
NEXT_PUBLIC_POSTHOG_HOST=infisical()

# Sentry
# @required
SENTRY_ORG=infisical()
# @required
SENTRY_PROJECT=infisical()
# @type=url @required
NEXT_PUBLIC_SENTRY_DSN=infisical()
# @type=url @required
NEXT_PUBLIC_SENTRY_CSP_REPORT_ENDPOINT=infisical()

# Feature Flags (FLAGS_SECRET optional — only needed for precompute)
# @sensitive @required=false
FLAGS_SECRET=fallback(infisical(allowMissing=true), "")
# @sensitive @required
STATSIG_SERVER_API_KEY=infisical()
