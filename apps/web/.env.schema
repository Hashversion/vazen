#
#
# Web owns no keys — it just combines packages. The Infisical file loads last when on, so it wins.
#
# @defaultRequired=infer @defaultSensitive=false
# @generateTsTypes(path=./env.ts, exposeEnv=local)
# @import(../../, pick=[INFISICAL_ENV])
# @import(../../packages/db/)
# @import(../../packages/auth/)
# @import(../../packages/email/)
# @import(../../packages/storage/)
# @import(../../packages/analytics/)
# @import(../../packages/security/)
# @import(../../packages/telemetry/)
# @import(../../packages/flags/)
# @import(./.env.infisical, enabled=$USE_INFISICAL)
#
# ----------

# Off by default (already-set variables / Docker defaults win). True = fetch from Infisical.
# @public @required=false @type=boolean
# @icon=mdi:sync
USE_INFISICAL=false
