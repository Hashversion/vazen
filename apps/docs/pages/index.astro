---
import PageLayout from "blume/components/layout/PageLayout.astro";
import data from "blume:data";

import TechStackSet from "../components/tech-stack-set";
import { Icons } from "../components/ui/icons";
import CopyCodeBlock from "../islands/CopyCodeBlock";

const { config } = data;
---

<style>
  @keyframes vazen-fade-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .vazen-rise {
    opacity: 0;
    animation: vazen-fade-up 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94)
      forwards;
  }

  .vazen-rise-slow {
    animation-duration: 1s;
  }

  @media (prefers-reduced-motion: reduce) {
    .vazen-rise {
      opacity: 1;
      animation: none;
    }
  }
</style>

<PageLayout
  site={{ title: config.title, description: config.description }}
  logo={config.logo}
  banner={config.banner}
  analytics={config.analytics}
  favicon={config.favicon}
  navigation={data.navigation}
  fontCssVars={data.fontCssVars}
  themeMode={config.theme.mode}
  searchEnabled={config.search.enabled}
  siteUrl={config.site}
  ogEnabled={config.og.enabled}
  page={{ title: config.title, description: config.description }}
>
  <Fragment slot="footer" />
  <section class="p-12">
    <div class="mx-auto max-w-340">
      <div class="max-w-prose space-y-5">
        <h1
          class="vazen-rise text-start text-2xl text-balance"
        >
          The production-grade starter kit for modern full-stack applications
        </h1>
        <div class="vazen-rise" style="animation-delay: 0.08s">
          <CopyCodeBlock
            client:load
            value="npx degit Hashversion/vazen <Your-Project>"
          />
        </div>
        <a
          href="https://web.vazen.dev"
          target="_blank"
          rel="noreferrer"
          style="animation-delay: 0.16s"
          class="vazen-rise inline-flex cursor-pointer items-center justify-center gap-2 rounded-full bg-black px-4 py-3 text-[14px] text-white dark:bg-white dark:text-black"
        >
          See Demo
          <Icons.LinkSquare />
        </a>
      </div>
    </div>
  </section>
  <section class="mt-12 overflow-y-hidden p-3">
    <div class="mx-auto max-w-340">
      <div
        style="animation-delay: 0.123s"
        class="vazen-rise vazen-rise-slow relative w-full border border-[#AAAAAA] bg-[#F0F0F0] p-5 dark:border-neutral-500 dark:bg-neutral-900"
      >
        <span
          class="absolute top-0 left-0 size-2 -translate-x-1/2 -translate-y-1/2 rounded-full bg-black dark:bg-white"
        />
        <span
          class="absolute top-0 right-0 size-2 translate-x-1/2 -translate-y-1/2 rounded-full bg-black dark:bg-white"
        />
        <span
          class="absolute bottom-0 left-0 size-2 -translate-x-1/2 translate-y-1/2 rounded-full bg-black dark:bg-white"
        />
        <span
          class="absolute right-0 bottom-0 size-2 translate-x-1/2 translate-y-1/2 rounded-full bg-black dark:bg-white"
        />
        <svg
          width="100%"
          height="100%"
          viewBox="0 0 1320 200"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
        >
          <defs>
            <pattern
              id="dots"
              width="40"
              height="40"
              patternUnits="userSpaceOnUse"
            >
              <circle cx="20" cy="20" r="20" fill="currentColor"></circle>
            </pattern>
          </defs>
          <rect width="100%" height="100%" fill="url(#dots)"></rect>
        </svg>
        <div class="flex flex-col items-center gap-8 pt-15.5">
          <h1
            class="max-w-[330px] text-center text-base text-neutral-600 md:max-w-[380px] md:text-lg dark:text-neutral-200"
          >
            Built with trusted tools powering the modern full-stack web
            ecosystem
          </h1>
          <TechStackSet />
        </div>
      </div>
    </div>
  </section>
</PageLayout>
